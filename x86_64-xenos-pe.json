{
  "llvm-target": "x86_64-unknown-windows",
  "metadata": {
    "description": "XenOS kernel PE32+ target",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "target-endian": "little",
  "target-pointer-width": 64,
  "arch": "x86_64",
  "os": "windows",
  "env": "",
  "vendor": "xenos",
  "data-layout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",

  "linker": "rust-lld",
  "linker-flavor": "msvc-lld",
  "linker-is-gnu": false,
  "lld-flavor": "link",

  "binary-format": "coff",
  "archive-format": "coff",
  "debuginfo-kind": "dwarf",

  "is-like-msvc": true,
  "is-like-windows": true,

  "executables": true,
  "exe-suffix": ".exe",
  "staticlib-prefix": "",
  "staticlib-suffix": ".lib",
  "dll-suffix": ".dll",

  "panic-strategy": "abort",
  "disable-redzone": true,

  "features": "+sse,+sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2,-mmx",

  "max-atomic-width": 64,

  "plt-by-default": false,
  "position-independent-executables": false,
  "static-position-independent-executables": false,

  "entry-abi": "win64",
  "entry-name": "KiSystemStartup",

  "pre-link-args": {
    "msvc-lld": [
      "/NOLOGO",
      "/ENTRY:KiSystemStartup",
      "/SUBSYSTEM:NATIVE",
      "/DRIVER",
      "/NODEFAULTLIB",
      "/BASE:0xFFFFF80000000000"
    ]
  },

  "stack-probes": {
    "kind": "none"
  },

  "singlethread": true,
  "emit-debug-gdb-scripts": false,
  "dll-tls-export": false,
  "allows-weak-linkage": false,
  "abi-return-struct-as-int": true,
  "crt-objects-fallback": "false"
}
