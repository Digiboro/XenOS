; XenCore SYSTEM hive template (generated by xenos/tools/mkhive)
;
; Этот INF можно расширять, добавляя Services/* для boot-start драйверов.
;

[Strings]
HiveName = "SYSTEM"
ControlSet = "ControlSet001"

[AddReg]
; -----------------------------------------------------------------------------
; HKLM\SYSTEM\Select
; -----------------------------------------------------------------------------
HKLM,"%HiveName%\\Select","Default",0x00010001,1
HKLM,"%HiveName%\\Select","Current",0x00010001,1
HKLM,"%HiveName%\\Select","LastKnownGood",0x00010001,1
HKLM,"%HiveName%\\Select","Failed",0x00010001,0

; -----------------------------------------------------------------------------
; ServiceGroupOrder - порядок загрузки групп драйверов
; REG_MULTI_SZ (0x00010000) - multi-string
; -----------------------------------------------------------------------------
HKLM,"%HiveName%\\%ControlSet%\\Control\\ServiceGroupOrder","List",0x00010000,"Boot Bus Extender","System Bus Extender","SCSI Miniport","Port","Primary Disk","SCSI Class","SCSI CDROM Class","Filter","FSFilter Infrastructure","FSFilter System","FSFilter Bottom","FSFilter Copy Protection","FSFilter Security Enhancer","FSFilter Open File","FSFilter Encryption","FSFilter Compression","FSFilter Cluster File System","FSFilter HSM","FSFilter Imaging","FSFilter Virtualization","FSFilter Physical Quota management","FSFilter Content Screener","FSFilter Quota Management","FSFilter System Recovery","FSFilter Undelete","FSFilter Anti-Virus","FSFilter Replication","FSFilter Continuous Backup","FSFilter Activity Monitor","FSFilter Top","Boot File System","Base","Pointer Port","Keyboard Port","Pointer Class","Keyboard Class","Video Init","Video","Video Save","File System","Event Log","Streams Drivers","NDIS","TDI","NetBIOSGroup","ShellSvcGroup","SchedulerGroup","SpoolerGroup","AudioGroup","SmartCardGroup","PlugPlay","NetworkProvider","PNP_TDI","NDIS Wrapper","NetDDEGroup","MS Transactions","ProfSvc_Group","UIGroup","LocalValidation","TermService","TermServDevices","TermServLicensing"

; -----------------------------------------------------------------------------
; Место для boot-start драйверов
; Пример (раскомментируйте и подправьте имя/путь):
; HKLM,"%HiveName%\\%ControlSet%\\Services\\XenTest","Start",0x00010001,0
; HKLM,"%HiveName%\\%ControlSet%\\Services\\XenTest","Type",0x00010001,1
; HKLM,"%HiveName%\\%ControlSet%\\Services\\XenTest","ErrorControl",0x00010001,1
; HKLM,"%HiveName%\\%ControlSet%\\Services\\XenTest","ImagePath",0,"\\SystemRoot\\System32\\drivers\\xentest.sys"

; -----------------------------------------------------------------------------
; PCI Bus Driver (Boot Bus Extender group - loads early)
; -----------------------------------------------------------------------------
HKLM,"%HiveName%\\%ControlSet%\\Services\\pci","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\pci","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\pci","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\pci","ImagePath",0,"\\SystemRoot\\system32\\drivers\\pci.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\pci","Group",0,"Boot Bus Extender"
HKLM,"%HiveName%\\%ControlSet%\\Services\\pci","Tag",0x00010001,1

; -----------------------------------------------------------------------------
; Storage Stack - New Architecture (Windows 7 model)
; -----------------------------------------------------------------------------

; StorPort - Port Driver (SCSI Miniport group)
HKLM,"%HiveName%\\%ControlSet%\\Services\\storport","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\storport","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\storport","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\storport","ImagePath",0,"\\SystemRoot\\system32\\drivers\\storport.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\storport","Group",0,"SCSI Miniport"
HKLM,"%HiveName%\\%ControlSet%\\Services\\storport","Tag",0x00010001,1

; msahci - AHCI Miniport Driver (SCSI Miniport group)
HKLM,"%HiveName%\\%ControlSet%\\Services\\msahci","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\msahci","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\msahci","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\msahci","ImagePath",0,"\\SystemRoot\\system32\\drivers\\msahci.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\msahci","Group",0,"SCSI Miniport"
HKLM,"%HiveName%\\%ControlSet%\\Services\\msahci","Tag",0x00010001,2

; Disk - Disk Class Driver (SCSI Class group)
HKLM,"%HiveName%\\%ControlSet%\\Services\\disk","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\disk","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\disk","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\disk","ImagePath",0,"\\SystemRoot\\system32\\drivers\\disk.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\disk","Group",0,"SCSI Class"
HKLM,"%HiveName%\\%ControlSet%\\Services\\disk","Tag",0x00010001,1

; PartMgr - Partition Manager (Filter group)
HKLM,"%HiveName%\\%ControlSet%\\Services\\partmgr","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\partmgr","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\partmgr","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\partmgr","ImagePath",0,"\\SystemRoot\\system32\\drivers\\partmgr.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\partmgr","Group",0,"Filter"
HKLM,"%HiveName%\\%ControlSet%\\Services\\partmgr","Tag",0x00010001,1

; VolMgr - Volume Manager (Filter group)
HKLM,"%HiveName%\\%ControlSet%\\Services\\volmgr","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\volmgr","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\volmgr","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\volmgr","ImagePath",0,"\\SystemRoot\\system32\\drivers\\volmgr.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\volmgr","Group",0,"Filter"
HKLM,"%HiveName%\\%ControlSet%\\Services\\volmgr","Tag",0x00010001,2

; MountMgr - Mount Manager (Filter group)
HKLM,"%HiveName%\\%ControlSet%\\Services\\mountmgr","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\mountmgr","Type",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\mountmgr","ErrorControl",0x00010001,3
HKLM,"%HiveName%\\%ControlSet%\\Services\\mountmgr","ImagePath",0,"\\SystemRoot\\system32\\drivers\\mountmgr.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\mountmgr","Group",0,"Filter"
HKLM,"%HiveName%\\%ControlSet%\\Services\\mountmgr","Tag",0x00010001,3

; -----------------------------------------------------------------------------
; FAT32 File System Driver (Boot File System group)
; -----------------------------------------------------------------------------
HKLM,"%HiveName%\\%ControlSet%\\Services\\fat32","Start",0x00010001,0
HKLM,"%HiveName%\\%ControlSet%\\Services\\fat32","Type",0x00010001,2
HKLM,"%HiveName%\\%ControlSet%\\Services\\fat32","ErrorControl",0x00010001,1
HKLM,"%HiveName%\\%ControlSet%\\Services\\fat32","ImagePath",0,"\\SystemRoot\\system32\\drivers\\fat32.dll"
HKLM,"%HiveName%\\%ControlSet%\\Services\\fat32","Group",0,"Boot File System"